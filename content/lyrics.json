   "chant": false
  },
  "v2.1": {
   "text": "Hands-on session: build a decision model",
   "section": "v2",
   "instrumental": false,
   "chant": false
  },
  "v2.2": {
   "text": "Unsloth and Hugging Face, full throttle",
   "section": "v2",
   "instrumental": false,
   "chant": false
  },
  "v2.3": {
   "text": "Fine-tune it on Gemma, let it make the call",
   "section": "v2",
   "instrumental": false,
   "chant": false
  },
  "v2.4": {
   "text": "Then fire up Hermes Agent, watch it learn it all",
   "section": "v2",
   "instrumental": false,
   "chant": false
  },
  "v2.5": {
   "text": "Five challenges, prizes on the line",
   "section": "v2",
   "instrumental": false,
   "chant": false
  },
  "v2.6": {
   "text": "Sixteen Arduino Uno Qs up for grabs this time",
   "section": "v2",
   "instrumental": false,
   "chant": false
  },
  "v2.7": {
   "text": "T-shirts and stickers and swag in the mix",
   "section": "v2",
   "instrumental": false,
   "chant": false
  },
  "v2.8": {
   "text": "Mama Rosa's pizza for the midday fix!",
