  },
  "i.2": {
   "text": "Revolution V-A and the AI Collective",
   "section": "intro",
   "instrumental": false,
   "chant": false
  },
  "i.3": {
   "text": "Hampton, wake up, it's Hacktoberfest!",
   "section": "intro",
   "instrumental": false,
   "chant": false
  },
  "v1.1": {
   "text": "Saturday, October seventeen",
   "section": "v1",
   "instrumental": false,
   "chant": false
  },
  "v1.2": {
   "text": "Hampton, Virginia, boot up the machine",
   "section": "v1",
   "instrumental": false,
   "chant": false
  },
  "v1.3": {
   "text": "Ten until four at the 757 Makerspace",
   "section": "v1",
   "instrumental": false,
   "chant": false
  },
  "v1.4": {
   "text": "Sixteen Murray Street, yeah, you know the place",
   "section": "v1",
   "instrumental": false,
   "chant": false
  },
  "v1.5": {
   "text": "Coffee and bagels when the morning's new",
   "section": "v1",
   "instrumental": false,
   "chant": false
  },
  "v1.6": {
   "text": "Bring a laptop, bring a charger, bring the crew",
   "section": "v1",
   "instrumental": false,
   "chant": false
  },
  "v1.7": {
   "text": "Open-source AI is the mission this year",
   "section": "v1",
   "instrumental": false,
   "chant": false
  },
  "v1.8": {
   "text": "'Cause AI belongs to everyone, so everyone's here!",
   "section": "v1",
   "instrumental": false,
   "chant": false
  },
  "ch.1": {
   "text": "From the sea to the stars (Hey!)",
   "section": "ch1",
   "instrumental": false,
   "chant": false
  },
  "ch.2": {
   "text": "Hacktoberfest in the Seven-Five-Seven!",
   "section": "ch1",
   "instrumental": false,
   "chant": false
  },
  "ch.3": {
   "text": "Build it in the open, let the whole world in",
   "section": "ch1",
   "instrumental": false,
   "chant": false
  },
  "ch.4": {
   "text": "It's free for everybody, so come on, let's begin!",
   "section": "ch1",
   "instrumental": false,
   "chant": false
  },
  "ch.5": {
   "text": "From the sea to the stars (Hey!)",
   "section": "ch1",
   "instrumental": false,
   "chant": false
  },
  "ch.6": {
   "text": "Hacktoberfest in the Seven-Five-Seven!",
   "section": "ch1",
   "instrumental": false,
   "chant": false
  },
  "ch.7": {
   "text": "Fork it, train it, ship it, show it",
   "section": "ch1",
   "instrumental": false,
   "chant": false
  },
  "ch.8": {
   "text": "Hampton's 'bout to glow, and you know it!",
   "section": "ch1",
   "instrumental": false,
   "chant": false
  },
  "pc1": {
